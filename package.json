{
  "name": "douyin-spark-local",
  "version": "0.1.0",
  "private": true,
  "description": "Local-only Douyin chat reminder assistant with explicit safety gates",
  "type": "module",
  "engines": {
    "node": ">=22.5"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "tsx src/server.ts",
    "build": "tsc -p tsconfig.json",
    "test": "tsx --test test/*.test.ts",
    "check": "npm run build && npm test"
  },
  "dependencies": {
    "playwright-core": "1.61.0"
  },
  "devDependencies": {
    "@types/node": "22.15.0",
    "tsx": "4.20.5",
    "typescript": "5.9.2"
  }
}
